{
    "name": "qos/science-sims",
    "description": "HKDSE / secondary science simulations and learning platform",
    "type": "project",
    "license": "proprietary",
    "require": {
        "php": ">=8.2"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.5"
    },
    "autoload": {
        "psr-4": {
            "ScienceSims\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "ScienceSims\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit"
    },
    "config": {
        "sort-packages": true
    }
}
