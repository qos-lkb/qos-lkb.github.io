# Serve static uploads only; block script execution
Options -Indexes
<FilesMatch "\.(php|phtml|php3|php4|php5|phps|cgi|pl|py)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>
