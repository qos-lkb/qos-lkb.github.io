# 複製為 .env 並填入實際值（本機／Docker 主機名可能是 localhost 或 db）

# 網站名稱（前台標題、管理後台顯示）
SITE_NAME=伊中中科學學習平台
SITE_NAME_EN=QESOSASS Science Learning Platform

# 應用程式時區（PHP 與 MySQL 連線）
APP_TIMEZONE=Asia/Hong_Kong

DB_HOST=db
DB_NAME=
DB_USER=
DB_PASS=
DB_CHARSET=utf8mb4
DB_UNIX_SOCKET=

# 選填：校本 QSIS 資料庫（唯讀；供後台「QSIS 匯入」讀取學生與班級）
# QSIS_DB_HOST=db
# QSIS_DB_NAME=qss_admin
# QSIS_DB_USER=qss_admin
# QSIS_DB_PASS=
# QSIS_DB_CHARSET=utf8mb4
# QSIS_DB_UNIX_SOCKET=
# QSIS_STUDENT_EMAIL_DOMAIN=student.qos.edu.hk

# 選填：index.html 會先請求 default_redirect_url.php，若有設定且通過白名單驗證則轉址
# DEFAULT_REDIRECT_URL=https://science.qos.edu.hk/
# 選填：允許的轉址 host（逗號分隔）；未設定時僅允許 https URL
# REDIRECT_URL_WHITELIST=science.qos.edu.hk,example.com

# 選填：生產環境 HTTPS 下請設為 1（includes/config.local.php 的 session_cookie_secure）
# SESSION_COOKIE_SECURE=1

# 選填：GitHub Pages 等跨域前端讀取唯讀 API 時設定（逗號分隔 Origin）
# CORS_ALLOWED_ORIGINS=https://qos-lkb.github.io

# 選填：設為 1 或 true 時，每次載入 index.php 會把目前輸出的完整 HTML 寫入 index.html（已 deprecated；主入口為 app/）
# WRITE_INDEX_HTML_SNAPSHOT=1

# 選填：完整 DSN 時可略過 DB_HOST／DB_NAME／DB_CHARSET（須自行含 charset）
# DB_DSN=mysql:host=127.0.0.1;dbname=science_sims;charset=utf8mb4
