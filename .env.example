# 複製為 .env 並填入實際值（本機／Docker 主機名可能是 localhost 或 db）
DB_HOST=localhost
DB_NAME=science_sims
DB_USER=science_sims
DB_PASS=
DB_CHARSET=utf8mb4
DB_UNIX_SOCKET=

# 選填：index.html 會先請求 default_redirect_url.php，若有設定則立即轉址至此 URL
# DEFAULT_REDIRECT_URL=https://example.com/

# 選填：設為 1 或 true 時，每次載入 index.php 會把目前輸出的完整 HTML 寫入 index.html（檔案很大，易干擾 Git；預設關閉）
# WRITE_INDEX_HTML_SNAPSHOT=1

# 選填：完整 DSN 時可略過 DB_HOST／DB_NAME／DB_CHARSET（須自行含 charset）
# DB_DSN=mysql:host=127.0.0.1;dbname=science_sims;charset=utf8mb4
